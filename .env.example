# OPENCODE SETTINGS (OpenAI-compatible)
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_MODEL=deepseek-v4-flash

# MIMO SETTINGS (OpenAI-compatible)
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_API_KEY=your_mimo_api_key_here
MIMO_MODEL=mimo-v2.5-pro

# OPENAI SETTINGS
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# GEMINI SETTINGS
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# LOCAL LLM SETTINGS (GGUF via llama-cpp)
# Download model from: https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf
LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf

# LAB CONFIG
# Options: opencode | mimo | openai | google
DEFAULT_PROVIDER=opencode
DEFAULT_MODEL=deepseek-v4-flash
LOG_LEVEL=INFO
